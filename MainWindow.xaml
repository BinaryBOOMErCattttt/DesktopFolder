<Window x:Class="DesktopFolder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文件夹"
        Icon="/DesktopFolder.ico"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        SizeChanged="Window_SizeChanged"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        PreviewMouseMove="Window_PreviewMouseMove"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp"
        PreviewMouseDown="Window_PreviewMouseDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="ItemButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ItemCard" TargetType="Button" BasedOn="{StaticResource ItemButton}">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.07" Duration="0:0:0.15">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.07" Duration="0:0:0.15">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.0" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.0" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IconTile" TargetType="Border">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="72"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Background" Value="#F6F7FA"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#0F000000"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <DropShadowEffect x:Key="PanelShadow" BlurRadius="40" ShadowDepth="0" Opacity="0.28" Color="#000000"/>
        <DropShadowEffect x:Key="WidgetShadow" BlurRadius="20" ShadowDepth="2" Opacity="0.22" Color="#000000"/>
    </Window.Resources>
    <Grid>
        <Border x:Name="InputLayer" Background="#01000000" Focusable="False"/>
        <Grid x:Name="WidgetPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="14"/>
            </Grid.RowDefinitions>
            <Border x:Name="WidgetBox" Grid.Row="1" Margin="14,0,14,0" CornerRadius="26"
                    Background="#F5FFFFFF" Effect="{StaticResource WidgetShadow}"
                    AllowDrop="True" DragOver="Panel_DragOver" Drop="Panel_Drop"
                    MouseLeftButtonDown="WidgetBox_MouseLeftButtonDown">
                <Grid x:Name="MiniArea" Margin="10">
                    <UniformGrid x:Name="MiniGrid"/>
                </Grid>
            </Border>
            <TextBlock x:Name="FolderNameLabel" Grid.Row="2" FontSize="12.5" Foreground="White"
                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="176">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.9" Color="Black"/>
                </TextBlock.Effect>
            </TextBlock>
        </Grid>

        <Border x:Name="FolderPanel" Margin="18" CornerRadius="36" Background="#F0FFFFFF"
                Effect="{StaticResource PanelShadow}" Visibility="Collapsed" Opacity="0"
                AllowDrop="True" DragOver="Panel_DragOver" Drop="Panel_Drop"
                MouseLeftButtonDown="FolderPanel_MouseLeftButtonDown">
            <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="FolderScale"/>
                    <TranslateTransform x:Name="FolderShift"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="76"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="30,16,24,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ExpandedName" FontSize="22" FontWeight="SemiBold"
                                   Foreground="#E62A2A2A" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                        <TextBlock x:Name="ItemCountText" Margin="12,5,0,0" FontSize="12.5"
                                   Foreground="#8C2A2A2A" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="HeaderGear" Width="36" Height="36" Style="{StaticResource ItemButton}"
                                ToolTip="菜单" Click="HeaderGear_Click" Margin="0,0,4,0">
                            <TextBlock Text="&#9881;" FontSize="14" Foreground="#B32A2A2A" TextAlignment="Center"/>
                            <Button.ContextMenu>
                                <ContextMenu Opened="Menu_Opened" Closed="Menu_Closed">
                                    <MenuItem x:Name="MenuOpen" Header="打开文件夹" Click="MenuOpen_Click"/>
                                    <MenuItem x:Name="MenuChange" Header="更换文件夹…" Click="MenuChange_Click"/>
                                    <MenuItem x:Name="MenuAutoStart" Header="开机自启动" IsCheckable="True"
                                              Click="MenuAutoStart_Click"/>
                                    <MenuItem x:Name="MenuNew" Header="新建小组件" Click="MenuNewWidget_Click"/>
                                    <MenuItem x:Name="MenuRefresh" Header="刷新" Click="MenuRefresh_Click"/>
                                    <Separator/>
                                    <MenuItem x:Name="MenuMode" Header="显示模式">
                                        <MenuItem x:Name="Mode2" Header="2 × 2" IsCheckable="True" Click="Mode2_Click"/>
                                        <MenuItem x:Name="Mode3" Header="3 × 3" IsCheckable="True" Click="Mode3_Click"/>
                                    </MenuItem>
                                    <MenuItem x:Name="MenuLang" Header="语言">
                                        <MenuItem x:Name="MenuLangZh" Header="中文" IsCheckable="True" Click="MenuLang_Click"/>
                                        <MenuItem x:Name="MenuLangEn" Header="English" IsCheckable="True" Click="MenuLang_Click"/>
                                    </MenuItem>
                                    <MenuItem x:Name="MenuHideExt" Header="隐藏文件后缀名" IsCheckable="True"
                                              IsChecked="True" Click="MenuHideExt_Click"/>
                                    <Separator/>
                                    <MenuItem x:Name="MenuDelete" Header="删除小组件" Click="MenuDeleteWidget_Click"/>
                                    <MenuItem x:Name="MenuExit" Header="退出" Click="MenuExit_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="CloseButton" Width="36" Height="36" Style="{StaticResource ItemButton}"
                                Click="CloseButton_Click">
                            <TextBlock Text="&#10005;" FontSize="14" Foreground="#B32A2A2A" TextAlignment="Center" Margin="0,-1,0,0"/>
                        </Button>
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="ItemsScroller" Grid.Row="1" Margin="24,4,24,20" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Focusable="False"
                              PreviewMouseWheel="ItemsScroller_PreviewMouseWheel">
                    <Grid>
                        <ItemsControl x:Name="ItemsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding PosX}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding PosY}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ItemCard}" Tag="{Binding}" Width="104"
                                            Click="Item_Click"
                                            PreviewMouseLeftButtonDown="Item_PreviewMouseLeftButtonDown"
                                            Height="110">
                                        <StackPanel>
                                            <Border Style="{StaticResource IconTile}">
                                                <Image Source="{Binding Icon}" Width="52" Height="52"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="11.5" Foreground="#E62A2A2A"
                                                       TextAlignment="Center" TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis" MaxHeight="30"
                                                       Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="EmptyHint" Text="文件夹为空" HorizontalAlignment="Center"
                                   Margin="0,70,0,0" FontSize="14" Foreground="#8C2A2A2A"
                                   Visibility="Collapsed"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
